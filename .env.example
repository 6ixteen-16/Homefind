DEMO_MODE=0
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=homefind_app
DB_PASS=replace-with-a-long-random-password
DB_NAME=homefinder_db
SESSION_TTL_SECONDS=3600
PRIVATE_UPLOAD_DIR=private_uploads
CORS_ORIGINS=http://127.0.0.1:8000

# One-time passcodes (only needed for users with otp_enabled = 1).
# In production OTP login is refused unless SMTP_HOST is set, so codes are never exposed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com
SMTP_STARTTLS=1

# ==============================================================================
# Backup Database Configuration (e.g. AWS RDS MySQL / Aurora)
# When configured, any data changes made on localhost are automatically mirrored.
# ==============================================================================
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_USER=
BACKUP_DB_PASS=
BACKUP_DB_NAME=homefinder_db

# Secret Super Admin Key required to wipe/drop the backup database
BACKUP_SUPERADMIN_SECRET_KEY=replace-with-a-very-long-random-string-known-only-by-superadmin
