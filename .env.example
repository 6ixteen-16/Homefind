DEMO_MODE=0
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=homefind_app
DB_PASS=replace-with-a-long-random-password
DB_NAME=homefinder_db
SESSION_TTL_SECONDS=3600
PRIVATE_UPLOAD_DIR=private_uploads
CORS_ORIGINS=http://127.0.0.1:8000

# One-time passcodes (only needed for users with otp_enabled = 1).
# In production OTP login is refused unless SMTP_HOST is set, so codes are never exposed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com
SMTP_STARTTLS=1

# ==============================================================================
# AWS S3 Cloud Backup Configuration
# When configured, full snapshots and real-time incremental write logs are synced to S3.
# ==============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=eu-north-1
AWS_S3_PREFIX=homefind/

# Secret Super Admin Key required to wipe/delete backup snapshots on S3
BACKUP_SUPERADMIN_SECRET_KEY=replace-with-a-very-long-random-string-known-only-by-superadmin
